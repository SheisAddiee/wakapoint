# Server values only. Set in Supabase > Edge Functions > Secrets.
# Never put any of these in frontend VITE_ variables or commit filled secret files.
# Obtain a secret test/live key from the NIPOST developer account.
NIPOST_API_KEY=nipost_test_REPLACE_ON_SERVER
# Comma-separated app origins, with no trailing slash. Add the deployed origin.
WAKAPOINT_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Supabase automatically supplies these to hosted Edge Functions; do not copy to Vite:
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY

# Auth provider settings below belong in Supabase's dashboard, not this function.
# GOOGLE_CLIENT_ID: Google Cloud > Google Auth Platform > Clients (Web application).
# GOOGLE_CLIENT_SECRET: same OAuth client, configured in Supabase Auth > Google.
# GOOGLE_REDIRECT_URI: https://YOUR_PROJECT.supabase.co/auth/v1/callback
# APP_AUTH_REDIRECT_URL: https://YOUR_APP_DOMAIN/ (Auth > URL Configuration allowlist).
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD/API credential, SMTP_SENDER_EMAIL:
#   obtain from your email provider and configure Supabase Auth > Custom SMTP.
# EMAIL_OTP_TEMPLATE: include {{ .Token }} in Auth > Email Templates > Magic Link.
# The commented names above are setup labels; the app does not read them as env vars.
