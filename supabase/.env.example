# Server values only. Set in Supabase > Edge Functions > Secrets.
# Never put any of these in frontend VITE_ variables or commit filled secret files.
# Obtain a secret test/live key from the NIPOST developer account.
NIPOST_API_KEY=nipost_test_REPLACE_ME
# Comma-separated app origins, with no trailing slash. Add the deployed origin.
WAKAPOINT_ALLOWED_ORIGINS=https://wakapoint.vercel.app,http://127.0.0.1:3000,http://localhost:3000

# Resend dashboard > API Keys. Use a sending key restricted to your verified domain.
RESEND_API_KEY=re_REPLACE_ME
# A real address on your verified sending domain, e.g. WakaPoint <auth@yourdomain.com>.
WAKAPOINT_EMAIL_FROM="WakaPoint <auth@REPLACE_ME.example>"
# Auth > Hooks > Send Email > Generate secret. Preserve the v1,whsec_ prefix.
SEND_EMAIL_HOOK_SECRET=v1,whsec_REPLACE_ME
WAKAPOINT_SITE_URL=https://wakapoint.vercel.app

# Worksheet only: enter these in Supabase Auth > Providers > Google, not Functions.
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-REPLACE_ME

# Supabase automatically supplies these to hosted Edge Functions; do not copy to Vite:
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_SECRET_KEYS (modern named secret-key JSON map, preferred when supplied)

# Auth provider settings below belong in Supabase's dashboard, not this function.
# GOOGLE_CLIENT_ID: Google Cloud > Google Auth Platform > Clients (Web application).
# GOOGLE_CLIENT_SECRET: same OAuth client, configured in Supabase Auth > Google.
# GOOGLE_REDIRECT_URI: https://twsgnqkxruoqkqwgzjal.supabase.co/auth/v1/callback
# APP_AUTH_REDIRECT_URL: https://wakapoint.vercel.app/ (Auth > URL Configuration allowlist).
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD/API credential, SMTP_SENDER_EMAIL:
#   obtain from your email provider and configure Supabase Auth > Custom SMTP.
# EMAIL_OTP_TEMPLATE: include {{ .Token }} in Auth > Email Templates > Magic Link.
# The commented names above are setup labels; the app does not read them as env vars.
