# Application configuration. These public values are bundled by Vite.
# Leave blank to run the local frontend; there is no credential form in the UI.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# NEVER place NIPOST_API_KEY or a Supabase service-role secret in a VITE_ variable.
# Configure upstream credentials in Supabase Edge Function secrets instead.
